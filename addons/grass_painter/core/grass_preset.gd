@tool
class_name GrassPreset
extends Resource
## Grass species definition: geometry, material, LOD and default scale of a grass kind.
## Save as .tres to share across regions.
## is_procedural=true: geometry generated by grass_leaf_mesh per "personalities" (zero assets).
## is_procedural=false: external meshes (Mesh or PackedScene), pointing at your own licensed assets.

enum ShaderKind { PROCEDURAL, SCAN }

@export var preset_name: String = "Grass"

@export_group("Geometry")
## true = procedural blades (mesh lists below ignored); false = external mesh/scene
@export var is_procedural: bool = true
## Near variants: each entry is one clump "model". Resource can be Mesh or PackedScene
## (all MeshInstance children are merged)
@export var lod0_assets: Array[Resource] = []
## Far variants (cross cards etc.); empty = near variants reused at distance
@export var lod1_assets: Array[Resource] = []
## Procedural variant "personalities" (only for is_procedural):
## per variant {blades: Vector2i, spread: float, width: float}
@export var personalities: Array[Dictionary] = [
	{"blades": Vector2i(8, 9), "spread": 0.85, "width": 0.90},
	{"blades": Vector2i(10, 11), "spread": 1.0, "width": 1.0},
	{"blades": Vector2i(12, 13), "spread": 1.15, "width": 1.1},
	{"blades": Vector2i(7, 9), "spread": 0.70, "width": 0.75},
]

@export_group("Material")
@export var shader_kind: ShaderKind = ShaderKind.PROCEDURAL
## Optional custom shader; when null the built-in shader of shader_kind is used
@export var shader_override: Shader
## Textures for SCAN shader (unused by PROCEDURAL)
@export var albedo_texture: Texture2D
@export var normal_texture: Texture2D
@export var trans_texture: Texture2D

@export_group("LOD")
@export_range(2.0, 100.0, 1.0) var lod_switch_distance: float = 22.0

@export_group("Default scale")
@export_range(0.5, 60.0, 0.5) var default_density: float = 10.0
@export_range(0.02, 3.0, 0.01) var default_height_min: float = 0.12
@export_range(0.02, 3.0, 0.01) var default_height_max: float = 0.20
## Average "natural height ratio" of external grass (used when converting between presets);
## procedural is always 1.0
@export_range(0.1, 1.0, 0.01) var avg_natural_ratio: float = 1.0


## Number of near variants. Procedural = personality count; external = lod0 count
func variant_count() -> int:
	return personalities.size() if is_procedural else maxi(1, lod0_assets.size())


## Whether variant vi renders as the dry/stubble kind (shader INSTANCE_CUSTOM.w = 1:
## straw tint, almost no wind). Procedural: the personality's "dry" flag; external: false.
func variant_dry(variant: int) -> bool:
	if not is_procedural:
		return false
	if variant < 0 or variant >= personalities.size():
		return false
	return bool(personalities[variant].get("dry", false))


## Whether separate far layers are needed: external grass with lod1 provided
func has_far_lod() -> bool:
	return (not is_procedural) and lod1_assets.size() > 0


## Source resource of a variant (near/far)
func source_asset(variant: int, far: bool) -> Resource:
	if is_procedural:
		return null
	var list: Array = lod1_assets if (far and lod1_assets.size() > 0) else lod0_assets
	var i := clampi(variant, 0, list.size() - 1)
	return list[i]


func get_shader(procedural_shader: Shader, scan_shader: Shader) -> Shader:
	if shader_override != null:
		return shader_override
	return scan_shader if shader_kind == ShaderKind.SCAN else procedural_shader
